# Copy to ~/.terraformrc to redirect all provider downloads through batlehub.
#
# The network_mirror block tells Terraform to fetch providers from the proxy
# instead of registry.terraform.io.  The "direct" block with exclude prevents
# Terraform from falling back to the public registry for the same providers.
#
# TWO CONSTRAINTS TERRAFORM IMPOSES, both measured against Terraform 1.8.5 —
# see RFC 0009 §12.3.
#
# 1. THE MIRROR URL MUST BE https. Terraform rejects a plain-http mirror
#    outright: "the mirror must be at an https: URL". That is why the URL below
#    is https even though the port is the local default — BatleHub has to be
#    behind TLS for a network mirror to work at all, including in development.
#
# 2. Terraform sends the token below to the mirror's *metadata* documents
#    (index.json, {version}.json) but NOT to the provider archive it then
#    downloads. So the registry must grant anonymous read:
#
#      [registries.rbac]
#      anonymous = ["releases:read", "source:read"]
#
#    or sit behind an authenticating ingress — the same constraint the VS Code
#    gallery has, for the same reason.

credentials "localhost:8080" {
  token = "change-me-user-token"
}

provider_installation {
  network_mirror {
    url     = "https://localhost:8080/proxy/my-terraform/"
    include = ["registry.terraform.io/*/*"]
  }

  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
