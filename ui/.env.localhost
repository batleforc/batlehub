# Mode `localhost` — the in-pod front (port 5174), used by `pnpm run dev:local`.
#
# It serves anything running *inside* the workspace pod: the browser sidecar and
# the rendered design gates. The pod shares one network namespace, so the API is
# reachable on plain localhost — no ingress, no TLS, no cross-origin preflight.
#
# This file is the fallback, not the authority. Vite gives `process.env`
# priority over every `.env` file, and `task` injects the repo-root `.env` into
# every task, so `task ui:dev:local` states the value itself. Without that, an
# inherited VITE_API_BASE_URL silently wins and both fronts end up on one API.
VITE_API_BASE_URL=http://localhost:8080
